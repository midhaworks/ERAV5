  {
    "id": "ledger",
    "instruction": "Repair the settlement library. Each row has status (string), amount (integer) and fee (nonnegative integer). Only status exactly 'paid' with amount>=0 is accepted. Each accepted row contributes amount-fee; others contribute zero. Fees may exceed amount. solve(rows) sums contributions. Preserve inputs and function signatures.",
    "files": {
      "validation.py": "def accepted(row): return row['status']=='paid'\n",
      "totals.py": "from validation import accepted\ndef net_total(rows): return sum(r['amount'] for r in rows if accepted(r))\n",
      "api.py": "from totals import net_total\ndef solve(rows): return net_total(rows)\n",
      "README.md": "Repair the settlement library. Each row has status (string), amount (integer) and fee (nonnegative integer). Only status exactly 'paid' with amount>=0 is accepted. Each accepted row contributes amount-fee; others contribute zero. Fees may exceed amount. solve(rows) sums contributions. Preserve inputs and function signatures.\n",
      "visible_tests.json": "[\n  {\n    \"entry\": \"validation.accepted\",\n    \"args\": [\n      {\n        \"status\": \"paid\",\n        \"amount\": -2,\n        \"fee\": 0\n      }\n    ],\n    \"expected\": false\n  },\n  {\n    \"entry\": \"api.solve\",\n    \"args\": [\n      [\n        {\n          \"status\": \"paid\",\n          \"amount\": 10,\n          \"fee\": 2\n        }\n      ]\n    ],\n    \"expected\": 8\n  },\n  {\n    \"entry\": \"api.solve\",\n    \"args\": [\n      [\n        {\n          \"status\": \"cancelled\",\n          \"amount\": 5,\n          \"fee\": 0\n        }\n      ]\n    ],\n    \"expected\": 0\n  }\n]\n"
    },
