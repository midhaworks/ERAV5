    "id": "shipping",
    "instruction": "Repair the shipping quotation library. Units and rates are nonnegative integers. Each shipment costs ceil(units/1000)*rate; zero units cost zero. A quote sums independent shipment costs. There is no base fee. Preserve inputs and function signatures.",
    "files": {
      "weights.py": "def billable(units): return units // 1000\n",
      "tariffs.py": "from weights import billable\ndef charge(units, rate): return billable(units)*rate + rate\n",
      "api.py": "from tariffs import charge\ndef solve(items, rate): return sum(charge(n, rate) for n in items)\n",
